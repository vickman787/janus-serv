# Copy to .env locally. Never paste secrets into chat or commit .env.
SUI_NETWORK=testnet
# Must match network. Native HTTP/2 gRPC, backend only.
TATUM_SUI_GRPC_URL=https://sui-testnet-grpc.gateway.tatum.io
TATUM_API_KEY=
# Optional read-only probe targets, from real deployed objects/transactions.
JANUS_CONTROL_OBJECT_ID=
JANUS_TRANSACTION_DIGEST=
JANUS_PACKAGE_ID=

# Walrus Memory account network is independent of the handover chain network.
WALRUS_MEMORY_NETWORK=mainnet
WALRUS_MEMORY_SERVER_URL=https://relayer.memory.walrus.xyz
WALRUS_MEMORY_ACCOUNT_ID=
# Dedicated memory-account delegate key, NOT a wallet seed or spending key.
WALRUS_MEMORY_DELEGATE_SECRET=
# Keep OpenServ records partitioned from the submitted Janus-sui edition.
WALRUS_MEMORY_NAMESPACE=janus-openserv
WALRUS_MEMORY_RECORD_PREFIX=janus-openserv-record

# Fresh OpenServ-only local database and record-signing key. Never point these
# at the submitted Janus-sui data directory.
JANUS_DATABASE_PATH=.data/janus-openserv.sqlite
JANUS_WRITER_KEY_PATH=.data/openserv-writer-private.pem
JANUS_ALLOWED_ORIGINS=http://127.0.0.1:4310,http://localhost:4310
# Unused by the current session design; session tokens are random and stored hashed.
JANUS_SESSION_SECRET=
DATABASE_URL=file:.data/janus-openserv.sqlite
PUBLIC_APP_URL=http://127.0.0.1:4310

# Optional deployment settings; same-origin HTTPS required outside localhost.
JANUS_RUNTIME_ORIGIN=http://127.0.0.1:4310
JANUS_BIND=127.0.0.1
JANUS_PORT=4311
SUI_CLI_PATH=.tools/sui/sui.exe

# Recovery Copilot (advisory only). Leave disabled until both provider keys
# are provisioned. Keys are server-only and must never be exposed as VITE_*.
COPILOT_ENABLED=false
DOLPHIN_API_KEY=
DOLPHIN_BASE_URL=https://lighthouse.dphn.ai/run/text-v/v1
DOLPHIN_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
SERV_API_KEY=
SERV_BASE_URL=https://inference-api.openserv.ai/v1
SERV_MODEL=gpt-5.4-mini
# Optional provider allowlist escape hatch for a documented deployment change.
COPILOT_ALLOW_CUSTOM_ENDPOINTS=false
COPILOT_PROVIDER_TIMEOUT_MS=60000
COPILOT_MAX_PROVIDER_RETRIES=1
COPILOT_MAX_OUTPUT_TOKENS=4000
COPILOT_MAX_PROMPT_CHARS=40000
COPILOT_MAX_JOBS_PER_ACTOR_PER_HOUR=10
COPILOT_MAX_JOURNAL_ENTRIES=20

