{
  "name": "janus-sui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "probe": "tsx --env-file-if-exists=.env scripts/probe.ts",
    "probe:memory-write": "tsx --env-file-if-exists=.env scripts/memory-write.ts",
    "probe:memory-restore": "tsx --env-file-if-exists=.env scripts/memory-restore.ts",
    "dev:api": "tsx --env-file-if-exists=.env apps/api/src/server.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "tsx --env-file-if-exists=.env apps/api/src/server.ts",
    "worker": "tsx --env-file-if-exists=.env apps/worker/src/main.ts",
    "test:browser": "playwright test",
    "compile:contract": "node scripts/compile-contract.mjs",
    "evidence:memories": "tsx --env-file-if-exists=.env scripts/collect-memory-evidence.ts"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.6",
    "@mysten-incubation/memwal": "^0.1.11",
    "@mysten/dapp-kit-react": "^2.1.43",
    "@mysten/sui": "^2.38.0",
    "@protobuf-ts/grpc-transport": "^2.11.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "@protobuf-ts/runtime-rpc": "2.11.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
